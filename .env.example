# Copy to .env and replace every CHANGE_ME value before starting the lab.
# Never commit .env. Values below are placeholders, not usable credentials.
POSTGRES_DB=bank_lab
POSTGRES_USER=bank_lab_app
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_A_LONG_RANDOM_PASSWORD
BANK_LAB_SESSION_PEPPER=CHANGE_ME_GENERATE_AT_LEAST_32_RANDOM_BYTES

# Secure local defaults
BANK_LAB_ENVIRONMENT=development
BANK_LAB_COOKIE_SECURE=false
BANK_LAB_AUTO_CREATE_SCHEMA=false
BANK_LAB_RUN_ID=BASELINE
